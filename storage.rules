rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Stesso registro di Firestore: adminUsers/<email-lowercase> status active.
    function isAdminUser() {
      return request.auth != null
        && request.auth.token.email is string
        && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.token.email.lower()))
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.token.email.lower())).data.status == 'active';
    }

    // Sfondi popup caricati dall'area admin.
    match /popup-images/{fileName} {
      // immagini pubbliche (servono al sito)
      allow read: if true;
      // upload/sostituzione: solo admin, max 2MB, solo immagini
      allow create, update: if isAdminUser()
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // delete: solo admin (request.resource e' nullo in delete)
      allow delete: if isAdminUser();
    }

    // Immagini evento caricate dall'area admin (come popup-images, max 3MB).
    match /event-images/{fileName} {
      allow read: if true;
      allow create, update: if isAdminUser()
        && request.resource != null
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdminUser();
    }

    // Immagini generate dalla callable generateImage (Admin SDK, che bypassa
    // le rules): lettura pubblica per il sito, scrittura client vietata.
    match /generated-images/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Asset social (immagini ritagliate, reel, video Veo). I video delle
    // callable (generateReelVideo) scrivono via Admin SDK. Upload client:
    // solo admin — immagini fino a 3MB, video fino a 50MB (reel brevi).
    match /social/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdminUser()
        && request.resource != null
        && request.resource.size <= 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'))
        && (request.resource.size <= 3 * 1024 * 1024
            || request.resource.contentType.matches('video/.*'));
      allow delete: if isAdminUser();
    }

    // Screenshot delle prove promo (gamification). Upload anonimo consentito
    // ma inerte: submitClaim accetta solo path col memberId del token chiamante.
    match /claims-inbox/{memberId}/{fileName} {
      allow read: if false; // le prove le vede solo lo staff (function/admin SDK)
      // resource == null: il POST REST semplice di firebase.storage viene
      // classificato 'create' anche su oggetto esistente (probe prod 11/09/26);
      // senza questa clausola un anonimo potrebbe sovrascrivere una prova.
      allow create: if resource == null
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // default deny su tutto il resto del bucket
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
