rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    // Gli utenti admin vivono in adminUsers/<email-lowercase>
    // { name, role: 'owner'|'editor', status: 'active'|'suspended' }.
    // exists() prima di get(): get su doc mancante fa fallire la rule.
    function adminDoc() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.token.email.lower())).data;
    }
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email.lower()))
        && adminDoc().status == 'active';
    }
    // Owner: come admin ma con role 'owner'. Solo gli owner gestiscono
    // adminUsers (vedi match sotto). I doc owner sono seminati via
    // Admin SDK (bypass rules) e immutabili dal client.
    function isOwner() {
      return isAdmin() && adminDoc().role == 'owner';
    }

    function validEmail(s) {
      return s is string
        && s.size() <= 120
        && s.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$');
    }

    function validPhone(s) {
      return s is string
        && s.matches('^[+0-9][0-9 .()-]{5,24}$');
    }

    // ---------- contenuti pubblici ----------

    // Eventi: lettura anonima solo dei doc attivi (query sempre con
    // where('active','==',true)); scrittura solo admin.
    match /events/{eventId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    // Popup: stesso schema degli eventi.
    match /popups/{popupId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- configurazione ----------

    // config/admin: DEPRECATO (sostituito da adminUsers). Resta leggibile
    // agli autenticati per compatibilità con versioni admin già caricate;
    // scrittura client sempre vietata.
    match /config/admin {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // adminUsers: registro degli utenti admin.
    // - lettura: qualunque admin attivo (la tab Utenti filtra lato UI)
    // - create: solo owner, e mai con role 'owner' (gli owner li semina
    //   l'Admin SDK; dal client nascono solo editor)
    // - update/delete: solo owner, e MAI su doc con role 'owner'
    //   (owner immutabili: non sospendibili/eliminabili/declassabili,
    //   nemmeno da se stessi). L'update non puo' promuovere a owner.
    match /adminUsers/{emailId} {
      allow read: if isAdmin();
      allow create: if isOwner()
        && request.resource.data.role == 'editor'
        && request.resource.data.status in ['active', 'suspended'];
      allow update: if isOwner()
        && resource.data.role != 'owner'
        && request.resource.data.role == 'editor'
        && request.resource.data.status in ['active', 'suspended'];
      allow delete: if isOwner()
        && resource.data.role != 'owner';
    }

    // config/gamification: staffPin e prizeOptions — SOLO admin.
    match /config/gamification {
      allow read, write: if isAdmin();
    }

    // ---------- prenotazioni ----------

    function newBookingIsValid() {
      let d = request.resource.data;
      return
        // shape: campi esatti, nessun extra (in particolare MAI 'emailed')
        d.keys().hasOnly([
          'name', 'date', 'time', 'guests', 'service', 'tableType',
          'eventTitle', 'phone', 'note', 'source', 'status', 'createdAt',
          'email'
        ])
        && d.keys().hasAll([
          'name', 'date', 'time', 'guests', 'service', 'tableType',
          'phone', 'note', 'source', 'status', 'createdAt'
        ])
        // no status forgery
        && d.status == 'new'
        // enum servizio
        && d['service'] is string
        && d['service'] in ['cena', 'after-cena', 'evento']
        // ospiti: intero 1..50
        && d.guests is int
        && d.guests >= 1
        && d.guests <= 50
        // stringhe con cap di lunghezza
        && d.name is string
        && d.name.size() >= 2
        && d.name.size() <= 80
        && d.date is string
        && d.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && d.time is string
        && d.time.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && d.tableType is string
        && d.tableType.size() >= 1
        && d.tableType.size() <= 40
        && (!d.keys().hasAny(['eventTitle'])
            || (d.eventTitle is string && d.eventTitle.size() <= 140))
        && validPhone(d.phone)
        && d.note is string
        && d.note.size() <= 500
        // origine: 'site' oppure 'popup:<id>'
        && d.source is string
        && (d.source == 'site'
            || d.source.matches('^popup:[A-Za-z0-9_-]{1,64}$'))
        // timestamp lato server
        && d.createdAt is timestamp
        && d.createdAt == request.time
        // email cliente opzionale, formato valido se presente
        && (!d.keys().hasAny(['email']) || validEmail(d.email));
    }

    match /bookings/{bookingId} {
      // create-only anonimo, forma validata. Il campo 'emailed' (scritto
      // dalla Cloud Function via Admin SDK) non e' ammesso nel create pubblico.
      allow create: if newBookingIsValid();
      // lettura, cambio stato, cancellazione: solo admin.
      allow read, update, delete: if isAdmin();
    }

    // ---------- newsletter ----------

    function newSubscriberIsValid() {
      let d = request.resource.data;
      return
        d.keys().hasOnly(['email', 'phone', 'consent', 'consentAt'])
        && d.keys().hasAll(['email', 'consent', 'consentAt'])
        // consenso GDPR: literal true obbligatorio
        && d.consent is bool
        && d.consent == true
        && validEmail(d.email)
        && d.consentAt is timestamp
        && d.consentAt == request.time
        && (!d.keys().hasAny(['phone']) || validPhone(d.phone));
    }

    match /newsletter/{docId} {
      // append-only: il docId e' l'email lowercase → create sulla stessa
      // chiave fallisce come duplicato. Update vietato a tutti lato client.
      allow create: if newSubscriberIsValid();
      // export/elenco e cancellazione GDPR: solo admin.
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- gamification ----------

    // Promo e badge: lettura anonima solo dei doc attivi; scrittura solo admin.
    match /promos/{promoId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }
    match /badges/{badgeId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    // members: nessun accesso anonimo; creazione solo via callable
    // (registerMember). Lettura da admin client (Task 11) per il join nome
    // nella tabella claim e la sezione "Referral sospetti": l'admin è staff
    // whitelistato e vede già nome/telefono in redeemQr; il token tessera
    // resta non esposto al pubblico. Scrittura client vietata a TUTTI:
    // contatori/badge si muovono solo dalle function.
    match /members/{memberId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // claims: lettura solo admin (tabella claim); scrittura solo via callable
    // (docId composto <promoId>_<memberId> gestito dalle function).
    match /claims/{claimId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- default deny ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
